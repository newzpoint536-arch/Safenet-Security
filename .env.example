# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUDIT_HMAC_SECRET: Required HMAC-SHA256 key for tamper-evident audit ledger integrity.
# Minimum 32 characters (recommended 64-char hex / 256-bit high-entropy secret).
# Production backend fails closed if missing or < 32 characters.
# HISTORICAL NOTICE: The prior development key was compromised and permanently revoked.
# Historical ledger entries remain preserved. Provide a fresh random secret in production.
AUDIT_HMAC_SECRET=""

# SUPABASE_URL: Production Supabase project URL (Phase 2B).
# SUPABASE_PUBLISHABLE_KEY: Client/Publishable key for public RLS-permitted queries.
# SUPABASE_ANON_KEY: Client/Publishable key alias.
# SUPABASE_SERVICE_ROLE_KEY: Service-role key for privileged backend operations (Phase 2B).
# DATABASE_URL: PostgreSQL connection string for direct pool connections (Phase 2B).
# OWNER_RECOVERY_KEY: One-time emergency administrative recovery secret (optional).
